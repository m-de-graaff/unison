{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["PARITY_CHROMIUM_PATH"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:parity": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PARITY_CHROMIUM_PATH",
        "PARITY_WEB_PROJECTS",
        "ANDROID_HOME",
        "ANDROID_SDK_ROOT",
        "JAVA_HOME",
        "DEVELOPER_DIR"
      ]
    }
  }
}
