{
  "name": "@unison-ui/ui",
  "version": "0.0.0",
  "description": "The public entry of Unison: one import that works on the web and in React Native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-de-graaff/unison.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/m-de-graaff/unison#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "browser": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "default": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      }
    }
  },
  "react-native": "./dist/native.js",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@unison-ui/native": "workspace:^",
    "@unison-ui/react": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@unison-ui/tsconfig": "workspace:*",
    "react": "catalog:",
    "react-native": "0.88.1",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
