{
  "name": "@unison-ui/motion",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/web/index.d.ts",
      "react-native": "./dist/native/index.js",
      "default": "./dist/web/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@unison-ui/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@unison-ui/tsconfig": "workspace:*",
    "react": "catalog:",
    "react-native": "0.88.1",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "^5.1.1"
  }
}
