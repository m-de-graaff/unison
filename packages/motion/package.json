{
  "name": "@unison-ui/motion",
  "version": "0.1.0",
  "description": "Motion helpers for Unison: springs and reduced-motion support for the web and React Native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-de-graaff/unison.git",
    "directory": "packages/motion"
  },
  "homepage": "https://github.com/m-de-graaff/unison#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/web/index.d.ts",
      "react-native": "./dist/native/index.js",
      "default": "./dist/web/index.js"
    },
    "./reanimated": {
      "types": "./dist/native/reanimated.d.ts",
      "default": "./dist/native/reanimated.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@unison-ui/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "*",
    "react-native-reanimated": ">=4.7.1 <5"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@unison-ui/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
