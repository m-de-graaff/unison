{
  "font-family": {
    "$type": "fontFamily",
    "sans": {
      "$value": "\"Inter Variable\", \"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
    },
    "mono": {
      "$value": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "font-size": {
    "$type": "dimension",
    "12": { "$value": "12px" },
    "13": { "$value": "13px" },
    "14": { "$value": "14px" },
    "16": { "$value": "16px" },
    "18": { "$value": "18px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "36": { "$value": "36px" }
  },
  "line-height": {
    "$type": "dimension",
    "16": { "$value": "16px" },
    "18": { "$value": "18px" },
    "20": { "$value": "20px" },
    "24": { "$value": "24px" },
    "28": { "$value": "28px" },
    "32": { "$value": "32px" },
    "40": { "$value": "40px" }
  },
  "letter-spacing": {
    "$type": "number",
    "$description": "Tracking in em; a typography composite reads it as { value, unit: \"em\" }",
    "0": { "$value": 0 },
    "tight": { "$value": -0.011 },
    "tighter": { "$value": -0.02 }
  }
}
