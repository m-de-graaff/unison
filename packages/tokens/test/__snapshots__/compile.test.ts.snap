"@theme inline {
  --color-accent: var(--unison-color-accent);
  --color-surface: var(--unison-color-surface);
  --color-fg: var(--unison-color-fg);
  --color-border: var(--unison-color-border);
  --radius-md: var(--unison-radius-md);
  --spacing: var(--unison-space-1);
  --animate-fade: var(--unison-animate-fade);
  --animate-fade-out: var(--unison-animate-fade-out);
  --animate-scale-in: var(--unison-animate-scale-in);
  --animate-scale-in-out: var(--unison-animate-scale-in-out);
  --animate-slide-up: var(--unison-animate-slide-up);
  --animate-slide-up-out: var(--unison-animate-slide-up-out);
  --animate-sheet: var(--unison-animate-sheet);
  --animate-sheet-out: var(--unison-animate-sheet-out);
  --animate-pop: var(--unison-animate-pop);
  --animate-pop-out: var(--unison-animate-pop-out);
  --animate-press: var(--unison-animate-press);
  --animate-press-out: var(--unison-animate-press-out);
}
"
`;

