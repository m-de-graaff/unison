"@theme inline {
  --color-accent: var(--unison-color-accent);
  --color-surface: var(--unison-color-surface);
  --color-fg: var(--unison-color-fg);
  --color-border: var(--unison-color-border);
  --radius-md: var(--unison-radius-md);
  --spacing: var(--unison-space-1);
}
"
`;

