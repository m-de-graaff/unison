  --unison-color-warning-subtle: #371e00;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --unison-color-accent: #545ed5;
    --unison-color-surface: #18181a;
    --unison-color-fg: #f1f2f5;
    --unison-color-border: #323337;
