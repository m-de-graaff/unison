    --unison-color-accent-hover: #33369c;
    --unison-color-accent-subtle: #1a1e4a;
    --unison-color-border-strong: #6d6e75;
    --unison-color-canvas: #0f0f10;
    --unison-color-danger: #c13234;
    --unison-color-danger-border: #8a0013;
    --unison-color-danger-fg: #ffccc5;
    --unison-color-danger-subtle: #430f0e;
    --unison-color-fg-muted: #9c9ea4;
