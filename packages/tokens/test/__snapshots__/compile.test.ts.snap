@supports not (transition-timing-function: linear(0, 1)) {
  :root {
    --unison-spring-bouncy: cubic-bezier(0.2, 0, 0, 1);
    --unison-spring-smooth: cubic-bezier(0.2, 0, 0, 1);
    --unison-spring-snappy: cubic-bezier(0.2, 0, 0, 1);
  }
}

@keyframes unison-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes unison-fade-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes unison-fade-reduced-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes unison-fade-reduced-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes unison-scale-in-in {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes unison-scale-in-out {
  from { opacity: 1; transform: scale(1); }
  to { opacity: 0; transform: scale(0.98); }
}

@keyframes unison-scale-in-reduced-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes unison-scale-in-reduced-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes unison-slide-up-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0px); }
}

@keyframes unison-slide-up-out {
  from { opacity: 1; transform: translateY(0px); }
  to { opacity: 0; transform: translateY(4px); }
}

@keyframes unison-slide-up-reduced-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes unison-slide-up-reduced-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes unison-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0px); }
}

@keyframes unison-sheet-out {
  from { transform: translateY(0px); }
  to { transform: translateY(100%); }
}

@keyframes unison-sheet-reduced-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes unison-sheet-reduced-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes unison-pop-in {
  from { transform: scale(0.9); }
  to { transform: scale(1); }
}

@keyframes unison-pop-out {
  from { transform: scale(1); }
  to { opacity: 0; }
}

@keyframes unison-pop-reduced-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes unison-pop-reduced-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes unison-press-in {
  from { transform: scale(1); }
  to { transform: scale(0.97); }
}

@keyframes unison-press-out {
  from { transform: scale(0.97); }
  to { transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  :root, [data-unison-theme="default"], [data-theme="light"] {
    --unison-animate-fade: unison-fade-reduced-in var(--unison-motion-duration-fast-enter) var(--unison-easing-linear) both;
    --unison-animate-fade-out: unison-fade-reduced-out var(--unison-motion-duration-fast-exit) var(--unison-easing-linear) both;
    --unison-animate-pop: unison-pop-reduced-in var(--unison-motion-duration-fast-enter) var(--unison-easing-linear) both;
    --unison-animate-pop-out: unison-pop-reduced-out var(--unison-motion-duration-fast-exit) var(--unison-easing-linear) both;
    --unison-animate-scale-in: unison-scale-in-reduced-in var(--unison-motion-duration-fast-enter) var(--unison-easing-linear) both;
    --unison-animate-scale-in-out: unison-scale-in-reduced-out var(--unison-motion-duration-fast-exit) var(--unison-easing-linear) both;
    --unison-animate-sheet: unison-sheet-reduced-in var(--unison-motion-duration-fast-enter) var(--unison-easing-linear) both;
    --unison-animate-sheet-out: unison-sheet-reduced-out var(--unison-motion-duration-fast-exit) var(--unison-easing-linear) both;
    --unison-animate-slide-up: unison-slide-up-reduced-in var(--unison-motion-duration-fast-enter) var(--unison-easing-linear) both;
    --unison-animate-slide-up-out: unison-slide-up-reduced-out var(--unison-motion-duration-fast-exit) var(--unison-easing-linear) both;
  }
}
"
`;
