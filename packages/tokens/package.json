{
  "name": "@unison-ui/tokens",
  "version": "0.0.0",
  "description": "Design tokens for Unison and the compiler that turns them into CSS variables, a Tailwind v4 theme and a typed React Native theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-de-graaff/unison.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/m-de-graaff/unison#readme",
  "type": "module",
  "files": [
    "dist",
    "tokens"
  ],
  "bin": {
    "unison-tokens": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spring": {
      "types": "./dist/spring.d.ts",
      "default": "./dist/spring.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    },
    "./native": {
      "types": "./dist/native/theme.d.ts",
      "default": "./dist/native/theme.js"
    },
    "./tokens.css": "./dist/web/tokens.css",
    "./theme.css": "./dist/web/theme.css",
    "./native-theme.css": "./dist/native/theme.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown && node dist/bin.js build",
    "dev": "tsx watch --include \"tokens/**\" src/bin.ts build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@unison-ui/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^5.1.1",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "colorjs.io": "^0.7.1",
    "culori": "^4.0.2"
  }
}
