    },
    "success-border": {
      "$value": "{color.success.400}",
      "$description": "Status border"
    },
    "on-success": {
      "$value": "{color.white}",
      "$description": "Text on solid status"
    },
    "warning": {
      "$value": "{color.warning.700}",
      "$description": "Solid status fill"
    },
    "warning-subtle": {
      "$value": "{color.warning.200}",
      "$description": "Status background"
    },
    "warning-fg": {
      "$value": "{color.warning.900}",
      "$description": "Status text on subtle"
    },
    "warning-border": {
      "$value": "{color.warning.400}",
      "$description": "Status border"
    },
    "on-warning": {
      "$value": "{color.black}",
      "$description": "Text on solid status"
    },
    "danger": {
      "$value": "{color.danger.500}",
      "$description": "Solid status fill"
    },
    "danger-subtle": {
      "$value": "{color.danger.200}",
      "$description": "Status background"
    },
    "danger-fg": {
      "$value": "{color.danger.900}",
      "$description": "Status text on subtle"
    },
    "danger-border": {
      "$value": "{color.danger.400}",
      "$description": "Status border"
    },
    "on-danger": {
      "$value": "{color.white}",
      "$description": "Text on solid status"
