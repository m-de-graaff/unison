    "info-border": {
      "$value": "{color.info.400}",
      "$description": "Status border"
    },
    "on-info": {
      "$value": "{color.white}",
      "$description": "Text on solid status"
    },
    "overlay": {
      "$value": "#00000099",
      "$description": "Scrim behind dialogs and sheets",
      "$extensions": {
        "dev.unison": {
          "raw": true
        }
      }
    }
