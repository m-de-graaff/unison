{
  "text": {
    "$type": "typography",
    "caption": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.regular}",
        "fontSize": "{font-size.12}",
        "lineHeight": "{line-height.16}",
        "letterSpacing": "{letter-spacing.0}"
      },
      "$description": "Helper text, timestamps"
    },
    "label": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.medium}",
        "fontSize": "{font-size.13}",
        "lineHeight": "{line-height.18}",
        "letterSpacing": "{letter-spacing.0}"
      },
      "$description": "Form labels, small buttons"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.regular}",
        "fontSize": "{font-size.14}",
        "lineHeight": "{line-height.20}",
        "letterSpacing": "{letter-spacing.0}"
      },
      "$description": "Dense UI, table cells"
    },
    "body": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.regular}",
        "fontSize": "{font-size.16}",
        "lineHeight": "{line-height.24}",
        "letterSpacing": "{letter-spacing.tight}"
      },
      "$description": "Default text"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.regular}",
        "fontSize": "{font-size.18}",
        "lineHeight": "{line-height.28}",
        "letterSpacing": "{letter-spacing.tight}"
      },
      "$description": "Lead paragraphs"
    },
    "title-sm": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.semibold}",
        "fontSize": "{font-size.16}",
        "lineHeight": "{line-height.24}",
        "letterSpacing": "{letter-spacing.tight}"
      },
      "$description": "Card titles"
    },
    "title": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.semibold}",
        "fontSize": "{font-size.20}",
        "lineHeight": "{line-height.28}",
        "letterSpacing": "{letter-spacing.tight}"
      },
      "$description": "Section titles"
    },
    "title-lg": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.semibold}",
        "fontSize": "{font-size.24}",
        "lineHeight": "{line-height.32}",
        "letterSpacing": "{letter-spacing.tighter}"
      },
      "$description": "Page titles"
    },
    "display": {
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontWeight": "{font-weight.bold}",
        "fontSize": "{font-size.36}",
        "lineHeight": "{line-height.40}",
        "letterSpacing": "{letter-spacing.tighter}"
      },
      "$description": "Hero text"
    },
    "code": {
      "$value": {
        "fontFamily": "{font-family.mono}",
        "fontWeight": "{font-weight.regular}",
        "fontSize": "{font-size.13}",
        "lineHeight": "{line-height.20}",
        "letterSpacing": "{letter-spacing.0}"
      },
      "$description": "Inline and block code"
    },
    "max-scale": {
      "$type": "number",
      "$value": 1.5,
      "$description": "Largest font-scale multiplier components allow on native (maxFontSizeMultiplier)",
      "$extensions": {
        "dev.unison": {
          "raw": true
        }
      }
    }
  }
}
