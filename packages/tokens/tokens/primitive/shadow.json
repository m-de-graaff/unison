{
  "shadow": {
    "$type": "shadow",
    "$description": "Light values; the dark scheme multiplies every alpha by 2.5 (capped at 0.5)",
    "xs": {
      "$value": [
        {
          "x": "0px",
          "y": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "#0000000d"
        }
      ]
    },
    "sm": {
      "$value": [
        {
          "x": "0px",
          "y": "1px",
          "blur": "3px",
          "spread": "0px",
          "color": "#0000001a"
        },
        {
          "x": "0px",
          "y": "1px",
          "blur": "2px",
          "spread": "-1px",
          "color": "#0000001a"
        }
      ]
    },
    "md": {
      "$value": [
        {
          "x": "0px",
          "y": "4px",
          "blur": "6px",
          "spread": "-1px",
          "color": "#0000001a"
        },
        {
          "x": "0px",
          "y": "2px",
          "blur": "4px",
          "spread": "-2px",
          "color": "#0000001a"
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "x": "0px",
          "y": "10px",
          "blur": "15px",
          "spread": "-3px",
          "color": "#0000001a"
        },
        {
          "x": "0px",
          "y": "4px",
          "blur": "6px",
          "spread": "-4px",
          "color": "#0000001a"
        }
      ]
    },
    "xl": {
      "$value": [
        {
          "x": "0px",
          "y": "20px",
          "blur": "25px",
          "spread": "-5px",
          "color": "#0000001a"
        },
        {
          "x": "0px",
          "y": "8px",
          "blur": "10px",
          "spread": "-6px",
          "color": "#0000001a"
        }
      ]
    }
  }
}
