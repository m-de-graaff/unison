{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@unison-ui/motion": "workspace:^",
    "@unison-ui/parity": "workspace:*",
    "@unison-ui/tokens": "workspace:*",
    "@unison-ui/ui": "workspace:*",
    "demo-content": "workspace:*",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.5",
    "uniwind": "^1.14.0"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.21.10",
    "@expo/repack-app": "0.10.4",
    "@types/react": "catalog:",
    "concurrently": "^10.0.7",
    "typescript": "catalog:"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "pnpm tokens",
    "dev": "concurrently --kill-others --names tokens,expo \"unison-tokens build --watch --config unison.config.ts --out unison\" \"expo start\"",
    "typecheck": "pnpm tokens && tsc --noEmit",
    "tokens": "unison-tokens build --config unison.config.ts --out unison"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
