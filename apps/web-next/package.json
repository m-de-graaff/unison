{
  "name": "web-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names tokens,next \"unison-tokens build --watch --config unison.config.ts --out unison\" \"next dev\"",
    "build": "pnpm tokens && next build",
    "start": "next start",
    "typecheck": "pnpm tokens && tsc --noEmit",
    "tokens": "unison-tokens build --config unison.config.ts --out unison"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@unison-ui/motion": "workspace:^",
    "@unison-ui/tokens": "workspace:*",
    "@unison-ui/ui": "workspace:*",
    "demo-content": "workspace:*",
    "next": "16.4.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^10.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:"
  }
}
